# Real data project — the only project containing your actual Gmail/
# Calendar/Granola data. Gated by magic-link auth restricted to
# neha.monga@gmail.com (hardcoded in lib/auth-context.tsx).
NEXT_PUBLIC_SUPABASE_REAL_URL=
NEXT_PUBLIC_SUPABASE_REAL_ANON_KEY=

# Demo project — fully separate Supabase project, fabricated data only,
# seeded once via script. Anonymous access, no auth required.
NEXT_PUBLIC_SUPABASE_DEMO_URL=
NEXT_PUBLIC_SUPABASE_DEMO_ANON_KEY=

# In the real project's Supabase dashboard (Authentication → URL
# Configuration), add this app's deployed origin (and localhost:3000 for
# dev) to "Redirect URLs" — magic links redirect back to the site root.
